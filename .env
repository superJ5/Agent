# 应用配置
APP_NAME=SuperBizAgent
APP_VERSION=1.0.0
APP_DEBUG=True
HOST=0.0.0.0
PORT=9900

# DashScope 配置
DASHSCOPE_API_KEY=sk-a82a6a5334f147cbae97e8c793ce182a
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 比赛接口认证
API_BEARER_TOKEN=sk-a82a6a5334f147cbae97e8c793ce182a

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=qwen3.5-plus
RAG_INTENT_STRATEGY=none
RAG_ENABLE_VECTOR_RECALL=true
RAG_ENABLE_BM25_RECALL=true
RAG_VECTOR_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4
RAG_ENABLE_SCAN_FALLBACK=true
RAG_SCAN_CANDIDATE_LIMIT=6000

# Reranker
RAG_RERANKER_PROVIDER=dashscope
RAG_RERANKER_MODEL=qwen3-rerank
RAG_RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RAG_RERANKER_TIMEOUT_MS=3000
RAG_RERANKER_TOP_N=32

# Memory
MEMORY_WRITE_ENABLED=false
MEMORY_ROOT=data/memory
MEMORY_RECENT_LIMIT=10
MEMORY_COLLECTION_NAME=memory
MEMORY_SEARCH_TOP_K=5
MEMORY_DAILY_MAX_CHARS=5000
MEMORY_SUMMARY_INPUT_MAX_CHARS=20000
MEMORY_SUMMARY_MODEL=qwen3.5-plus

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio（本地进程）、streamable-http（HTTP 流）
# 也可以配置真实的cls mcp服务： https://cloud.tencent.com/developer/mcp/server/11710
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
